{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and branch assignment",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["مدير النظام", "مدير الفرع", "محاسب", "خياط", "موظف استقبال"] },
        "branchId": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Staff member working in the tailor shop",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "phone": { "type": "string" },
        "active": { "type": "boolean" },
        "assignedOrdersCount": { "type": "number" },
        "initials": { "type": "string" }
      },
      "required": ["id", "name", "role", "active"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Tailor shop customer record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "isVip": { "type": "boolean" },
        "totalOrders": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phone"]
    },
    "Measurement": {
      "title": "Measurement",
      "description": "Customer thobe/garment measurement specifications",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "length": { "type": "number" },
        "shoulder": { "type": "number" },
        "chest": { "type": "number" },
        "arm": { "type": "number" },
        "neck": { "type": "number" },
        "cuff": { "type": "number" },
        "expansion": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["customerId", "length", "shoulder", "chest", "arm", "neck"]
    },
    "Order": {
      "title": "Order",
      "description": "Bespoke tailoring order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "isVip": { "type": "boolean" },
        "status": { "type": "string", "enum": ["new", "tailoring", "ready", "delivered"] },
        "statusLabel": { "type": "string" },
        "priority": { "type": "string", "enum": ["normal", "urgent"] },
        "deliveryDate": { "type": "string" },
        "deliveryDateLabel": { "type": "string" },
        "garmentType": { "type": "string" },
        "garmentTitle": { "type": "string" },
        "garmentSubtitle": { "type": "string" },
        "piecesCount": { "type": "number" },
        "progressPercent": { "type": "number" },
        "currentStageName": { "type": "string" },
        "tailorName": { "type": "string" },
        "tailorVerified": { "type": "boolean" },
        "fabricRollId": { "type": "string" },
        "fabricName": { "type": "string" },
        "fabricCode": { "type": "string" },
        "metersRequired": { "type": "number" },
        "totalPrice": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "notes": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "deliveredTime": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "customerName", "status", "totalPrice"]
    },
    "Fabric": {
      "title": "Fabric",
      "description": "Fabric bolts and rolls inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "origin": { "type": "string" },
        "flag": { "type": "string" },
        "widthInches": { "type": "number" },
        "colorName": { "type": "string" },
        "remainingMeters": { "type": "number" },
        "totalMeters": { "type": "number" },
        "costPrice": { "type": "number" },
        "retailPrice": { "type": "number" },
        "stockStatus": { "type": "string" },
        "alertMessage": { "type": "string" }
      },
      "required": ["id", "code", "name", "remainingMeters"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Tax invoice and receipts compliant with ZATCA",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "dateLabel": { "type": "string" },
        "timeLabel": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "vatAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["paid", "partial", "pending"] },
        "paymentMethod": { "type": "string" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" }
      },
      "required": ["id", "invoiceNumber", "customerName", "amount", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System and inventory operation audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "timeAgo": { "type": "string" },
        "description": { "type": "string" },
        "actor": { "type": "string" }
      },
      "required": ["id", "title", "description", "actor"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts and roles"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Shop staff directory"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Client directory"
    },
    "/measurements/{measurementId}": {
      "schema": "Measurement",
      "description": "Customer body sizing"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders in tailor pipeline"
    },
    "/fabrics/{fabricId}": {
      "schema": "Fabric",
      "description": "Textile fabric rolls"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Financial tax invoices"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Activity audit log trail"
    }
  }
}
